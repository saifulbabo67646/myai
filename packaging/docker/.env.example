# myai deployment environment template (docs/myai-plan.md §4.7).
#
# Placeholders only — never commit a filled-in copy. Copy this file next to the
# compose file, replace every value, and keep the copy out of version control
# (packaging/docker/.gitignore ignores .env and the TLS directory):
#
#   cd packaging/docker
#   cp .env.example .env
#   chmod 600 .env
#   docker compose --env-file .env -f docker-compose.myai.yml --profile tls up -d --build
#
# The compose file fails closed on any value it still needs: an unset or empty
# variable below stops `docker compose` before a container is created, and the
# server itself refuses to boot on a short secret, a missing data directory, a
# missing workspace root, or a non-loopback runtime URL.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Public HTTPS base URL of this installation, as users reach it. No trailing slash.
MYAI_PUBLIC_BASE_URL=https://myai.example.com

# Control-session signing secret. At least 32 characters in production.
# Generate with: openssl rand -base64 48
MYAI_SESSION_SECRET=replace-me-with-at-least-32-characters

# One-time first-owner bootstrap secret. The first owner must present it in the
# X-Myai-Bootstrap-Secret header; rotate it away once the owner exists.
# Generate with: openssl rand -hex 32
MYAI_BOOTSTRAP_SECRET=replace-me-with-a-random-bootstrap-secret

# Host directory holding workspace storage. Must be writable by uid 10001
# (chown 10001:10001 <dir>) and is mounted read-write into both containers.
# Back this directory up together with the control-data volume.
MYAI_WORKSPACE_HOST_PATH=/srv/myai/workspaces

# ---------------------------------------------------------------------------
# Edge / TLS (used by the optional `tls` profile)
# ---------------------------------------------------------------------------

# Bind address and port for the published HTTPS endpoint. Keep the bind on
# loopback unless a host-level load balancer or firewall fronts it.
MYAI_EDGE_BIND=127.0.0.1
MYAI_EDGE_PORT=8443

# Host directory containing tls.crt and tls.key (PEM, mounted read-only).
MYAI_TLS_CERT_DIR=./tls

# ---------------------------------------------------------------------------
# Optional overrides
# ---------------------------------------------------------------------------

# Pin images instead of building from this checkout. Prefer an immutable tag
# or digest once you publish your own registry.
# MYAI_SERVER_IMAGE=myai-server:local
# MYAI_RUNTIME_IMAGE=myai-runtime:local
# MYAI_TLS_PROXY_IMAGE=nginx:1.29-alpine
